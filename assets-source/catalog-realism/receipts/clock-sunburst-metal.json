    "artifactSetSha256": "f4329edf9ccadc88c1da6cc36988f687cfc096cc735e8cb6088bc0bdc0415e80",
    "views": {
      "front": "The radial metal rays and layered clock face retain a clear sunburst silhouette.",
      "rear": "The closed rear case joins the alternating long and short rays consistently.",
      "detail": "Full detail preserves all raised numerals and hands, but their inherited dark-on-dark contrast remains limited; brass ticks stay legible.",
