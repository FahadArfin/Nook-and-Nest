    "reviewer": "Codex independent catalog visual review",
    "artifactSetSha256": "e7578b6529558165cbc3978503bb298d6b6f04116dd89e18aebcac2f493fe643",
    "views": {
      "front": "The table retains its original slab while its two stone arches now meet rectangular piers with matching stock width.",
      "rear": "The opposite supports have coherent arch-to-pier transitions instead of the previous rounded overhanging sleeves.",
      "detail": "The close view preserves the smooth slab edge and shows restrained block joints at the fitted pier tops.",
      "underside": "Full-size inspection confirms clean semicircular openings and supported bridge ends, without the former scalloped dark notches.",
      "clay": "Clay shows continuous arch silhouettes seated beneath the tabletop. Small visible stone block joints are an acceptable construction detail."
    }
  }
