{
  "name": "nook-and-nest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test": "node scripts/test-brief.mjs",
    "test:related": "node scripts/test-brief.mjs --related",
    "build": "vite build && node scripts/prepare-sites-build.mjs && node scripts/optimize-model-assets.mjs && node scripts/build-project-server.mjs",
    "preview": "vite preview",
    "test:assets": "node --test tests/model-asset-sharing.test.mjs tests/model-geometry-compression.test.mjs tests/ar-geometry.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs tests/google-tiles.test.mjs tests/shared-tools-server.test.mjs tests/staging-server.test.mjs",
    "test:watch": "vitest",
    "assets:verify": "node scripts/verify-asset-pipeline.mjs",
    "assets:inventory": "node scripts/verify-asset-pipeline.mjs --inventory"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@google/model-viewer": "4.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "3d-tiles-renderer": "0.5.2",
    "drizzle-orm": "^0.45.2",
    "earcut": "^3.2.3",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "immer": "^11.1.18",
    "lz-string": "^1.5.0",
    "meshoptimizer": "1.2.0",
    "pdfjs-dist": "^6.3.289",
    "polygon-clipping": "^0.15.7",
    "qrcode": "1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.183.2",
    "vite": "6.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/earcut": "^3.0.0",
    "@types/node": "^26.4.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
