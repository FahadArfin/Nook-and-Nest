{
  "version": 1,
  "recipes": [
    {
      "id": "quality-models",
      "generators": [
        "tools/blender/build_quality_models.py"
      ],
      "inputs": [
        "tools/blender/modern_manifest.json"
      ],
      "outputs": [
        "assets-source/blender/{id}.blend",
        "public/models/furniture/{id}.glb"
      ],
      "notes": "Base family builder; inspect imported builders and selected IDs before rerunning."
    },
    {
      "id": "studio-models",
      "generators": [
        "tools/blender/build_studio_collection.py"
      ],
      "inputs": [
        "src/studioExpansion.json"
      ],
      "outputs": [
        "assets-source/blender/{id}.blend",
        "public/models/furniture/{id}.glb",
        "src/studioShelfSurfaces.json",
        "assets-source/studio-model-audit.json"
      ],
      "notes": "Overrides selected base IDs as well as studio IDs; script is authoritative for selection."
    },
    {
      "id": "apartment-models",
      "generators": [
        "tools/blender/build_apartment_collection.py"
      ],
      "inputs": [
        "src/apartmentExpansion.json"
      ],
      "outputs": [
        "assets-source/blender/{id}.blend",
        "public/models/furniture/{id}.glb",
        "assets-source/apartment-model-audit.json"
      ],
      "notes": "Apartment collection IDs."
    },
    {
      "id": "designed-home-models",
      "generators": [
        "tools/blender/build_designed_home_collection.py"
      ],
      "inputs": [
        "src/designedHomeExpansion.json"
      ],
      "outputs": [
        "assets-source/blender/{id}.blend",
        "public/models/furniture/{id}.glb",
        "assets-source/designed-home-model-audit.json"
      ],
      "notes": "Designed-home collection IDs."
    },
    {
      "id": "previews",
      "generators": [
        "tools/blender/render_catalog.py",
        "scripts/compress-previews.py"
      ],
      "inputs": [
        "assets-source/blender"
      ],
      "outputs": [
        "assets-source/previews/{id}.png",
        "public/models/previews/{id}.webp"
      ],
      "notes": "Render first, then lossless compression; inspect renderer output path before running."
    },
    {
      "id": "material-metadata",
      "generators": [
        "scripts/catalog-materials.mjs"
      ],
      "inputs": [
        "public/models/furniture"
      ],
      "outputs": [
        "src/modelMaterials.json"
      ],
      "notes": "Regenerate after model export; collection material scripts may patch selected IDs."
    },
    {
      "id": "release-models",
      "generators": [
        "scripts/optimize-model-assets.mjs"
      ],
      "inputs": [
        "public/models/furniture"
      ],
      "outputs": [
        "dist/client/models/furniture/{id}.glb"
      ],
      "notes": "Build-only optimization; never replace editable originals."
    },
    {
      "id": "library-release",
      "generators": [
        "scripts/prepare-library-assets.mjs"
      ],
      "inputs": [
        "public/models",
        "public/textures"
      ],
      "outputs": [
        "release/library-manifest.json"
      ],
      "notes": "Release packaging owns output directory and content hashes."
    },
    {
      "id": "kitchen-essentials",
      "generators": [
        "tools/blender/build_kitchen_essentials.py"
      ],
      "inputs": [
        "src/kitchenEssentialsExpansion.json",
        "assets-source/kitchen-essentials-references.json"
      ],
      "outputs": [
        "assets-source/blender/{id}.blend",
        "public/models/furniture/{id}.glb",
        "assets-source/previews/{id}.png",
        "public/models/previews/{id}.webp",
        "assets-source/kitchen-essentials-audit.json"
      ],
      "notes": "Only these twelve new IDs. Author via official interactive Blender MCP build(id), render configured scene then compress-previews.py. Other scenes remain untouched."
    },
    {
      "id": "household-collection",
      "generators": [
        "tools/blender/build_household_collection.py",
        "scripts/household-assets.mjs"
      ],
      "inputs": [
        "tools/blender/household_architecture.py",
        "tools/blender/household_bath_laundry.py",
        "tools/blender/household_entry.py",
        "tools/blender/household_entry_variety.py",
        "tools/blender/household_fixture_variety.py",
        "tools/blender/household_geometry.py",
        "tools/blender/household_materials.py",
        "tools/blender/test_household_materials.py",
        "tools/blender/household_lighting_office.py",
        "tools/blender/household_lighting_variety.py",
        "tools/blender/household_specialty.py",
        "tools/blender/household_specialty_variety.py",
        "tools/blender/household_utilities.py",
        "src/householdArchitectureExpansion.json",
        "src/householdBathLaundryExpansion.json",
        "src/householdEntryExpansion.json",
        "src/householdEntryVarietyExpansion.json",
        "src/householdFixtureVarietyExpansion.json",
        "src/householdLightingOfficeExpansion.json",
        "src/householdLightingVarietyExpansion.json",
        "src/householdSpecialtyExpansion.json",
        "src/householdSpecialtyVarietyExpansion.json",
        "src/householdUtilitiesExpansion.json",
        "assets-source/household-bath-laundry-references.json",
        "assets-source/household-entry-references.json",
        "assets-source/household-entry-variety-references.json",
        "assets-source/household-fixture-variety-references.json",
        "assets-source/household-lighting-office-references.json",
        "assets-source/household-lighting-variety-references.json",
        "assets-source/household-specialty-references.json",
        "assets-source/household-specialty-variety-references.json",
        "assets-source/household-utilities-references.json",
        "assets-source/household-progress.json",
        "scripts/household-asset-state.mjs",
        "scripts/compress-previews.py"
      ],
      "outputs": [
        "assets-source/blender/{id}.blend",
        "public/models/furniture/{id}.glb",
        "assets-source/previews/{id}.png",
        "public/models/previews/{id}.webp",
        "src/modelMaterials.json",
        "src/householdSupportFootprints.json",
        "src/householdShelfSurfaces.json",
        "assets-source/household-collection-audit.json",
        "assets-source/household-material-keys.json",
        "assets-source/household-progress.json"
      ],
      "notes": "Original editable household geometry. Root serializes official Blender MCP build(id), inspects front/rear/underside renders, then runs household-assets.mjs for targeted material keys and optional pixel-identical previews. No unrelated metadata/preview writes; file observation is never visual/browser/release acceptance. See docs/household-collection.md."
    }
  ]
}
